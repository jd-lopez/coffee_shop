---
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
const items = await getCollection("items");
import AddToCartButton from "../cart/AddToCart";
---

<section class="p-4 bg-lightbg/50">
  <div id="" class="flex flex-col relative gap-4">
    <h1 class="text-2xl font-bold text-primary px-2">Sip the Sun</h1>
    <div id="filterContainer" class="sticky top-20 z-40 pb-2">
      <div
        class="flex flex-col justify-between mt-3 md:flex-row gap-3 items-center"
      >
        <div
          class="filter-container p-2 flex justify-between gap-6 overflow-x-scroll scroll"
        >
          <button class="menuCategoryBtn active" data-category="all"
            >All items</button
          >
          <button class="menuCategoryBtn" data-category="hot coffee"
            >Hot Coffee</button
          >
          <button class="menuCategoryBtn" data-category="iced coffee"
            >Iced coffe</button
          >
          <button class="menuCategoryBtn" data-category="brew gears"
            >Brew Gears</button
          >
          <button class="menuCategoryBtn" data-category="pastries"
            >Pastries</button
          >
        </div>
        <div class="p-2">
          <label for="">Sort By:</label>
          <select
            name="sorting"
            id="sort-select"
            class="text-sm border border-black rounded-2xl px-1 py-0.5"
          >
            <option value="">Select an option</option>
            <option value="lowtohigh">Price: Lowest to highest</option>
            <option value="hightolow">Price: Highest to lowest</option>
          </select>
        </div>
      </div>
    </div>
    <div
      id="target"
      class="grid grid-cols-2 md:grid-cols-4 gap-2 md:gap-6 px-2"
    >
      {
        items.map((item) => {
          const { id, title, price, image } = item.data;

          return (
            <div
              id={item.data.id}
              class="menu-card flex flex-col justify-between bg-white shadow-md rounded-2xl  "
              data-category={item.data.category}
              data-price={item.data.price}
            >
              <div class="relative overflow-hidden rounded-t-2xl h-50">
                <img
                  src={item.data.image}
                  alt=""
                  class="hover:scale-110 transition-all ease-in duration-200 bg-center bg-cover w-full h-full"
                />
              </div>
              <div class="px-4 py-2 flex  flex-col gap-3 flex-1">
                <div class="min-h-18 md:min-h-6 flex justify-between">
                  <h1 class="text-primary font-bold">{item.data.title}</h1>
                  <p class="text-tertiary font-bold">${item.data.price}</p>
                </div>

                <p class="text-neutral leading-4.5 ">{item.data.description}</p>

                <AddToCartButton
                  client:load
                  item={{ id, title, price, image }}
                />
                {/* <button class="flex items-center justify-center gap-3 rounded-2xl   px-2 py-1 bg-primary text-white mt-auto active:scale-90 transition-all duration-150 ease-in">
                
              </button> */}
              </div>
            </div>
          );
        })
      }
    </div>
  </div>

  <script>
    const initMenuFilterAndSort = () => {
      const buttons = document.querySelectorAll(".menuCategoryBtn");
      const cards = document.querySelectorAll(".menu-card");
      const grid = document.getElementById("target");
      const selectedSort = document.getElementById("sort-select");

      if (!(grid instanceof HTMLElement)) return;
      if (!(selectedSort instanceof HTMLSelectElement)) return;

      function applyFilterAndSort() {
        const activeButton = document.querySelector(".menuCategoryBtn.active");
        const category =
          activeButton instanceof HTMLButtonElement
            ? activeButton.dataset.category
            : "all";

        const allCards = Array.from(
          document.querySelectorAll(".menu-card"),
        ).filter((card): card is HTMLElement => card instanceof HTMLElement);

        allCards.forEach((card) => {
          const cardCategory = card.dataset.category;
          const shouldShow = category === "all" || cardCategory === category;
          card.classList.toggle("hidden", !shouldShow);
        });

        const visibleCards = allCards.filter(
          (card) => !card.classList.contains("hidden"),
        );

        const sortedCards = [...visibleCards];

        if (selectedSort.value === "lowtohigh") {
          sortedCards.sort((a, b) => {
            const priceA = Number(a.dataset.price);
            const priceB = Number(b.dataset.price);
            return priceA - priceB;
          });
        }

        if (selectedSort.value === "hightolow") {
          sortedCards.sort((a, b) => {
            const priceA = Number(a.dataset.price);
            const priceB = Number(b.dataset.price);
            return priceB - priceA;
          });
        }

        sortedCards.forEach((card) => grid.appendChild(card));
      }

      buttons.forEach((button) => {
        if (
          !(button instanceof HTMLButtonElement) ||
          button.dataset.bound === "true"
        ) {
          return;
        }

        button.dataset.bound = "true";

        button.addEventListener("click", () => {
          buttons.forEach((btn) => {
            if (btn instanceof HTMLButtonElement) {
              btn.classList.remove("active");
            }
          });

          button.classList.add("active");
          applyFilterAndSort();
        });
      });

      if (selectedSort.dataset.bound !== "true") {
        selectedSort.dataset.bound = "true";

        selectedSort.addEventListener("change", () => {
          applyFilterAndSort();
        });
      }

      applyFilterAndSort();
    };

    initMenuFilterAndSort();
    document.addEventListener("astro:page-load", initMenuFilterAndSort);

    //sort by

    // changing color to fixed filters
    const container = document.getElementById("filterContainer");

    const target = document.getElementById("target");

    function checkPosition() {
      if (!container || !target) return;
      const containerRect = container?.getBoundingClientRect();
      const targetRect = target?.getBoundingClientRect();

      if (containerRect?.bottom >= targetRect?.top) {
        container?.classList.add("bg-white", "shadow-lg");
      } else {
        container?.classList.remove("bg-white", "shadow-lg");
      }
    }

    window.addEventListener("scroll", checkPosition);
    window.addEventListener("resize", checkPosition);

    checkPosition();
  </script>
</section>
