---
const year = new Date().getFullYear();
---

<footer
  class="bg-primary rounded-tl-2xl rounded-tr-2xl flex flex-col items-center py-5 px-4 gap-4 md:flex-row md:px-10 md:justify-between border-secondary border-t-2
  landscape:flex-row landscape:justify-between"
>
  <div class="text-white">
    <h1>My Coffee Shop</h1>
  </div>
  <ul class="text-green-300">
    <li>Privacy Policy</li>
    <li>Terms of Service</li>
    <li>Contact Us</li>
    <li>Careers</li>
  </ul>
  <div class="text-tertiary">
    <p>@ <span>{year}</span> My Coffee Shop.</p>
  </div>
</footer>
