---
import { Icon } from "astro-icon/components";
---

<section class="pastries px-4 py-10 md:px-28 md:py-16">
  <div class="h-full">
    <h1 class="text-xs text-tertiary">RECIÉN SALIDO DE LA PANADERÍA</h1>
    <div class="flex justify-between items-center mt-1 mb-10">
      <h1 class="text-2xl font-bold text-primary">Delicias Horneadas al Sol</h1>
      <button
        class="text-sm text-white bg-primary px-2 md:px-2 md:py-1 rounded-2xl md:hover:shadow-md md:text-lg shadow-green-500 transition-all duration-200"
        >Explorar todos los Pasteles</button
      >
    </div>

    <div class="flex justify-between">
      <button id="prevBtn"><Icon name="mdi:arrow-back" class="size-8" /></button
      >
      <button id="nextBtn"
        ><Icon name="mdi:arrow-forward" class="size-8" /></button
      >
    </div>

    {/*Grid items */}
    <div id="wrapper" class="mt-2 overflow-x-auto no_scrollbar">
      <div class="flex gap-3">
        <div class="flex flex-col gap-2">
          <div class="rounded-md shadow-md overflow-hidden size-68 group">
            <img
              src="/images/desktop/tropical-crossant.png"
              alt=""
              class="bg-center bg-cover w-full h-full rounded-md group-hover:scale-105 transition-transform duration-500"
            />
          </div>
          <div>
            <h1 class="pastriesTitle">Mango-curd Croissant</h1>
            <p class="pastriesDesc">Twice-baked with handmake mango jam</p>
          </div>
        </div>
        <div class="flex flex-col gap-2">
          <div class="rounded-lg shadow-md overflow-hidden size-68 group">
            <img
              src="/images/desktop/pistachio.png"
              alt=""
              class="bg-center bg-cover w-full h-full rounded-lg group-hover:scale-105 transition-transform duration-500"
            />
          </div>
          <div>
            <h1 class="pastriesTitle">Tropical Financier</h1>
            <p class="pastriesDesc">
              Pistachio, lime zest, and coconut blossom
            </p>
          </div>
        </div>
        <div class="flex flex-col gap-2">
          <div class="rounded-md shadow-md overflow-hidden size-68 group">
            <img
              src="/images/desktop/chocolate.png"
              alt=""
              class="bg-center bg-cover w-full h-full rounded-md group-hover:scale-105 transition-transform duration-500"
            />
          </div>
          <div>
            <h1 class="pastriesTitle">Dark Cocoa Sunrise</h1>
            <p class="pastriesDesc">70% dark chocolate with a hint of x</p>
          </div>
        </div>
        <div class="flex flex-col gap-2">
          <div class="rounded-md shadow-md overflow-hidden size-68 group">
            <img
              src="/images/bread.jpg"
              alt=""
              class="bg-center bg-cover w-full h-full rounded-md group-hover:scale-105 transition-transform duration-500"
            />
          </div>
          <div>
            <h1 class="pastriesTitle">Lorem ipsum dolor</h1>
            <p class="pastriesDesc">Lorem ipsum dolor sit amet consectetur .</p>
          </div>
        </div>
        <div class="flex flex-col gap-2">
          <div class="rounded-md shadow-md overflow-hidden size-68 group">
            <img
              src="/images/bread.jpg"
              alt=""
              class="bg-center bg-cover w-full h-full rounded-md group-hover:scale-105 transition-transform duration-500"
            />
          </div>
          <div>
            <h1 class="pastriesTitle">Lorem ipsum dolor sit</h1>
            <p class="pastriesDesc">Lorem ipsum dolor sit amet consectetur</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const prevBtn = document.getElementById("prevBtn");
  const nextBtn = document.getElementById("nextBtn");
  const wrapper = document.getElementById("wrapper");

  const scrollAmount = 272;

  nextBtn?.addEventListener("click", () => {
    wrapper?.scrollBy({ left: scrollAmount, behavior: "smooth" });
  });

  prevBtn?.addEventListener("click", () => {
    wrapper?.scrollBy({ left: -scrollAmount, behavior: "smooth" });
  });
</script>
