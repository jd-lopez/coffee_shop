---
import { Icon } from "astro-icon/components";
---

<section class="px-4 py-10 md:px-28 md:py-15">
  <div class="flex flex-col items-center gap-4">
    <div
      class="flex flex-col relative justify-between gap-10 md:flex-row md:items-center rounded-4xl landscape:flex-row"
    >
      <div class="md:w-180 md:h-90 relative">
        <div class="rounded-4xl h-full overflow-hidden relative">
          <img
            src="/images/desktop/coffee-bean.png"
            alt=""
            class="bg-center bg-cover rounded-4xl w-full h-full hover:scale-105 transition-all duration-200 ease-in-out"
          />
        </div>

        <div
          class="absolute -bottom-5 -right-4 bg-white rounded-xl p-4 shadow-lg ring-1 ring-secondary
          landscape:p-2"
        >
          <h1 class="text-secondary text-2xl font-bold">Est. 2014</h1>
          <p class="text-xs">BORN UNDER THE TROPICAL SUN</p>
        </div>
      </div>

      <div class="flex flex-col gap-4">
        <h3 class="text-primary text-xs">OUR PHYLOSOPHY</h3>
        <h1 class="text-5xl font-bold">
          Energized by <span class="text-tertiary">Nature's Pulse</span>
        </h1>
        <p class="text-sm text-neutral">
          At Coffee Shop, we believe every cup should be a celebration of light
          and flavour. We source directly from sun-drenched estates that
          prioritize the planet.
        </p>
        <p class="text-sm text-neutral">
          Our roasting process is calibrated to preserve the vibrant acidity and
          tropical sweetness found only in the world's most exceptional
          harvests.
        </p>

        <div class="flex gap-2 items-center">
          <p>Discover the journey</p>
          <button class="rounded-full bg-secondary/60 p-2"
            ><Icon name="mdi:arrow-top-right" class="size-4" /></button
          >
        </div>
      </div>
    </div>

    <div
      class="relative rounded-2xl mt-6 md:mt-20 md:w-180 md:h-80 overflow-hidden group"
    >
      <div class="absolute inset-0 z-10 bg-primary/50 rounded-2xl"></div>

      <img
        src="/images/coffee-stay.jpg"
        alt=""
        class="bg-center landscape:h-60 landscape:w-140 rounded-2xl md:h-full md:w-full md:group-hover:scale-105 transition-all duration-200 md:landscape:h-full md:landscape:w-full"
      />

      <div
        class="flex gap-4 z-10 flex-col items-center absolute top-6 left-1 landscape:left-1/10 landscape:top-1/4 text-xs text-white md:text-sm md:top-1/4 md:landscape:left-0"
      >
        <h1 class="text-lg md:text-2xl font-bold">Find Your Sunshine</h1>
        <p class="md:px-30 text-center">
          Step into our vibrant spaces designed to recharge your spirit and
          awaken your senses
        </p>

        <div class="flex gap-3">
          <div
            class="bg-white/5 shadow-2xl backdrop-blur-md backdrop-saturate ring ring-gray-400 rounded-xl px-2 py-1 text-center"
          >
            <p class="text-secondary text-xs">The Flagship</p>
            <p>Downtown Oasis</p>
          </div>
          <div
            class="bg-white/5 shadow-2xl backdrop-blur-md backdrop-saturate ring ring-gray-400 rounded-xl px-2 py-1 text-center"
          >
            <p class="text-secondary text-xs">The Flagship</p>
            <p>Downtown Oasis</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
