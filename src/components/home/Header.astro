---
import { Icon } from "astro-icon/components";
import CartIcon from "../cart/CartIcon";
---

<header class="sticky bg-lightbg top-0 w-full h-20 md:h-20 z-50 shadow-md">
  <div
    class="relative flex justify-between h-full px-4 md:px-28 md:flex md:justify-between items-center py-3"
  >
    <a href="/" class="text-primary h-20 font-bold text-sml md:text-2xl">
      <img
        src="/images/menu/logo-5.svg"
        alt=""
        class="h-full w-full rounded-full"
      />
    </a>

    <ul
      id="nav-links"
      class="absolute top-full left-0 right-0 bg-white flex flex-col gap-1 w-full origin-top scale-y-0 opacity-0 pointer-events-none transition-all duration-300 ease-out shadow-xl md:static md:flex-row md:w-fit md:scale-y-100 md:opacity-100 md:pointer-events-auto md:shadow-none md:bg-inherit md:gap-3 text-primary"
    >
      <a
        href="/menu/"
        class="flex items-center gap-6 text-lg navBtn border-b-2 border-transparent hoverEffect"
        ><Icon name="mdi:restaurant-menu" /> Menu</a
      >
      <a
        class="flex items-center gap-6 text-lg navBtn border-b-2 border-transparent hoverEffect"
      >
        <Icon name="mdi:about-circle-outline" /> About</a
      >
      <a
        class="flex items-center gap-6 text-lg navBtn border-b-2 border-transparent hoverEffect"
      >
        <Icon name="mdi:location" /> Locations</a
      >
    </ul>

    <a href="/cart/" class="flex items-center gap-5">
      <CartIcon client:only="react" />
    </a>

    <button type="button" id="hamburger" class="md:hidden">
      <Icon name="mdi:menu" class="size-10" />
    </button>
  </div>
</header>

<script>
  if (!document.documentElement.dataset.headerMenuBound) {
    document.documentElement.dataset.headerMenuBound = "true";

    document.addEventListener("click", (e) => {
      const target = e.target;
      if (!(target instanceof Element)) return;

      const toggleButton = document.getElementById("hamburger");
      const menu = document.getElementById("nav-links");

      if (
        !(toggleButton instanceof HTMLElement) ||
        !(menu instanceof HTMLElement)
      ) {
        return;
      }

      const openMenu = () => {
        menu.classList.remove("scale-y-0", "opacity-0", "pointer-events-none");
        menu.classList.add("scale-y-100", "opacity-100", "pointer-events-auto");
      };

      const closeMenu = () => {
        menu.classList.remove(
          "scale-y-100",
          "opacity-100",
          "pointer-events-auto",
        );
        menu.classList.add("scale-y-0", "opacity-0", "pointer-events-none");
      };

      if (toggleButton.contains(target)) {
        const isOpen = menu.classList.contains("scale-y-100");
        if (isOpen) {
          closeMenu();
        } else {
          openMenu();
        }
        return;
      }

      if (!menu.contains(target)) {
        closeMenu();
      }
    });
  }
</script>
