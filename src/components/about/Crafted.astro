---
import { Icon } from "astro-icon/components";
---

<section class="p-6 md:px-30 bg-lightbg">
  <div class="py-4">
    <h1 class="text-center text-2xl text-primary font-bold">
      Crafted with Joy
    </h1>
    <p class="text-center text-sm">
      3 pilares simples definen cada copa que elaboramos y grano que horneamos
    </p>

    <div class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-2">
      <div
        class="group rounded-2xl p-4 py-8 bg-white gap-2 shadow md:col-span-2"
      >
        <div class="rounded-full bg-green-300 w-fit p-2">
          <Icon
            name="mdi:white-balance-sunny"
            class="size-6 group-hover:animate-spin"
          />
        </div>
        <h1 class="text-2xl text-primary font-bold">Bright profiles</h1>
        <p class="md:w-98">
          We specialize in light-to-medium roasts that highlight the natural
          floral and citrus notes of the coffee cherry
        </p>
      </div>
      <div
        class="group rounded-2xl p-4 py-8 bg-primary text-white gap-2 shadow"
      >
        <div>
          <Icon name="mdi:recycle" class="text-2xl group-hover:animate-spin" />
        </div>
        <h1 class="text-2xl font-bold text-lightbg">Zero Waste</h1>
        <p>
          From grounds to gardens: we compost 100% of our organic shop waste.
        </p>
      </div>
      <div class="rounded-2xl gap-2 shadow relative">
        <div
          class="rounded-2xl absolute inset-0 bg-linear-to-t from-green-600/40 to-transparent to-30%"
        >
        </div>

        <img
          src="/images/about/group-talking.png"
          alt=""
          class="h-46 w-full rounded-2xl object-cover"
        />
        <div class="absolute bottom-2 text-white left-14">
          <h1 class="text-xl font-bold">Comunidad primero</h1>
          <p>Nuestro impacto Local</p>
        </div>
      </div>
      <div
        class="group rounded-2xl p-4 py-8 bg-secondary/50 gap-2 shadow md:col-span-2"
      >
        <div>
          <Icon name="mdi:award" class="text-2xl group-hover:animate-ping" />
        </div>
        <h1 class="text-2xl font-bold text-lightbg">Award Winning Roast</h1>
        <p>
          Recognized for our Ethiopian Yirgacheffe as the brightest cup of the
          year in the 2023 Roasters Guild.
        </p>
      </div>
    </div>
  </div>
</section>
