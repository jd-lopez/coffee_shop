---
import "../styles/global.css";
import { Font } from "astro:assets";
import Header from "../components/home/Header.astro";
import Footer from "../components/home/Footer.astro";
import { ClientRouter, fade, slide } from "astro:transitions";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" />
    <title>Astro Basics</title>
    <ClientRouter />
    <Font cssVariable="--font-jakarta" />
  </head>
  <body
    transition:animate={fade({ duration: "0.4s" })}
    class="overflow-x-hidden"
  >
    <div class="body-wrapper relative flex flex-col justify-between">
      <Header />
      <div class="">
        <slot />
      </div>
      <Footer />
    </div>
  </body>
</html>
